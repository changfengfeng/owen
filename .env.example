# Operator-only deployment configuration. Never commit .env or real values.
CLOUD_DOMAIN=agent.example.com
POSTGRES_PASSWORD=replace-with-a-long-random-hex-password
CLOUD_DATABASE_URL=postgresql+psycopg://cloudagent:replace-with-a-long-random-hex-password@db:5432/cloudagent
CLOUD_SIGNUP_CODE=replace-with-a-long-random-invitation-code
CLOUD_LLM_API_KEY=replace-with-your-provider-key
CLOUD_LLM_BASE_URL=https://api.deepseek.com/v1
CLOUD_LLM_MODEL=deepseek-chat
CLOUD_LLM_MAX_OUTPUT_TOKENS=4096
CLOUD_LLM_MAX_TRUNCATION_RETRIES=2
# stat -c '%g' /var/run/docker.sock
DOCKER_GID=999
